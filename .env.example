# Used by docker-compose.yml (copy to .env). Server/client have their own .env.example for local dev.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
GITHUB_TOKEN=
FRONTEND_URL=http://localhost:3000

# Email codes (verify email, forgot password). Leave SMTP empty locally: the codes are printed in
# `docker compose logs -f server`. For real emails fill all four and set EMAIL_TO_CONSOLE=false.
EMAIL_TO_CONSOLE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PrepDost <no-reply@localhost>
