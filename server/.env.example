
# Server environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/prepdost

# Authentication
JWT_SECRET=replace-with-strong-secret-min-32-characters

# AI provider — OpenRouter
OPENROUTER_API_KEY=your-openrouter-key-here

# Voice provider — Deepgram
DEEPGRAM_API_KEY=your-deepgram-key-here

# Code execution — Judge0
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-here

# Frontend origin
FRONTEND_URL=http://localhost:3000

# Optional: GitHub contribution heatmap via the official GraphQL API.
# Create a token with NO scopes at github.com/settings/tokens.
# Without it, the dashboard falls back to a public contributions mirror.
GITHUB_TOKEN=

# Email verification and password reset
# In development, leave SMTP_HOST empty to print 6-digit codes in the terminal.
# SMTP configuration is required when NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PrepDost <no-reply@localhost>

# Local Docker Compose only (it uses NODE_ENV=production):
# Uncomment to allow verification codes in logs.
# EMAIL_TO_CONSOLE=true
