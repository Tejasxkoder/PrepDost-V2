# --- Backend (server-side only; read by the /api/v1 proxy route handler) ---
BACKEND_URL=http://localhost:5000

# --- Client ---
# Base path the browser calls (served by src/app/api/v1/[...path]/route.ts).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# true  = every feature uses src/mocks (no backend needed)
# false = real Express backend. Inlined at build time: restart/rebuild after changing.
NEXT_PUBLIC_USE_MOCKS=false

# --- Google sign-in (optional) ---
# Same Web client ID as the server's GOOGLE_CLIENT_ID. Read by the /login and /signup pages when they are
# rendered (NOT inlined at build time), so a restart is enough after changing it. Empty = no Google button.
GOOGLE_CLIENT_ID=
