    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.50.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
